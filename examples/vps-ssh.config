Host mac-project
    HostName __MAC_TAILSCALE_IPV4__
    User __MAC_USERNAME__
    Port 22
    IdentityFile ~/.ssh/claude_mac_ed25519
    IdentitiesOnly yes
    HostKeyAlias claude-mac-project
    UserKnownHostsFile ~/.ssh/claude_mac_known_hosts
    StrictHostKeyChecking yes
    ControlMaster auto
    ControlPersist 1h
    ControlPath ~/.ssh/claude-mac-%C
    ServerAliveInterval 10
    ServerAliveCountMax 2
