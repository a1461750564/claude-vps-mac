Host CLAUDE-VPS
    HostName __VPS_PUBLIC_HOSTNAME_OR_IP__
    HostKeyAlias __VPS_PUBLIC_HOSTNAME_OR_IP__
    User root
    Port 22
    IdentityFile ~/.ssh/claude_vps_admin_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    ControlMaster auto
    ControlPersist 1h
    ControlPath ~/.ssh/claude-vps-%C
    ServerAliveInterval 20
    ServerAliveCountMax 3
